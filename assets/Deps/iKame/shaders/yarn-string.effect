CCEffect %{
  techniques:
  - name: ditcumay
    passes:
    - vert: unlit-vs:vert
      frag: unlit-fs:frag
      properties: &props
        mainTexture:    { value: white }
        mainColor:      { value: [1, 1, 1, 1], editor: { type: color } }
        shadowColor:      { value: [0.5, 0.5, 0.5, 0], linear: true, editor: { type: color } }
        tiling:  { value: [1, 1], editor: { type: vector, range: [0.1, 10], step: 0.01 } }
        fill:    { value: 1, editor: { slide: true, range: [0, 2.0], step: 0.001 } }
}%

CCProgram unlit-vs %{
  precision mediump float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/local-batch>

  out mediump vec2 v_uv;

  mediump vec4 vert () {
    mediump vec4 position;
    CCVertInput(position);

    mediump mat4 matWorld;
    CCGetWorldMatrix(matWorld);

    v_uv = a_texCoord;

    return cc_matProj * (cc_matView * matWorld) * position;
  }
}%

CCProgram unlit-fs %{
  precision mediump float;
  #include <legacy/output-standard>
  
  
  in mediump vec2 v_uv;
  uniform sampler2D mainTexture;

  uniform Constant {
    mediump vec4 mainColor;
    mediump vec4 shadowColor;
  mediump vec2 tiling;

  mediump float fill;
  };

  mediump vec3 SetSaturation(mediump vec3 In, mediump float Saturation)
  {
    mediump float luma = dot(In, vec3(0.2126729, 0.7151522, 0.0721750));
    return luma + Saturation * (In - luma);
  }
  mediump vec4 frag () {
  mediump vec2 tiledUV = v_uv * tiling;
  mediump vec3 mask = texture(mainTexture, tiledUV).rgb;

  // retain the original alpha / fill effect
  mediump float uv2 = v_uv.y ;
  mediump float fill2 = fill;
  if (fill > 1.0)
  {
    uv2 = 1.0 - v_uv.y;
    fill2 = fill - 1.0;
  }
	mediump float alpha = clamp(((uv2*0.85+0.15)-(1.0-fill2))*5.0,0.0,1.0);
	
	if (alpha < 0.005) discard;

  // Knit-style color shading
  mediump vec3 colorLinear = mainColor.rgb * mainColor.rgb;
  mediump vec3 shadowBase = colorLinear * 0.5;
  mediump float maskR = mask.x;
  mediump float maskBlend = clamp(maskR + 0.4, 0.0, 1.0);
  mediump vec3 diffuseColor = mix(shadowBase, mainColor.rgb, maskR);
  mediump vec3 highlightColor = diffuseColor * 1.3 + 0.001;
  mediump float spec = clamp(mask.y, 0.0, 1.0);
  mediump vec3 litColor = mix(diffuseColor, highlightColor, spec);
  mediump vec3 finalColor = mix(shadowBase, litColor, maskBlend);
  finalColor = SetSaturation(finalColor, 2.0);

	return CCFragOutput(vec4(finalColor, 1.0));
  }
}%
